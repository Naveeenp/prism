# Set default behavior to automatically normalize line endings
* text=auto

# Source code files - enforce LF for portability
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.ino text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
